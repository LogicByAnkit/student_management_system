public class Student {
    String name;
    int roll;
    double marks;
    Course course;
    public Student(String name,int roll,double marks,Course course ){
        this.name=name;
        this.roll=roll;
        this.marks=marks;
        this.course=course;
    }
    public void displayInfo(){
        System.out.println("Name : "+name);
        System.out.println("roll : "+roll);
        System.out.println("marks : "+marks);
        if(course!=null)
        course.display_course();
        else
            System.out.println("Course : Not Assingned");
    }
    public Student(String name,int roll){
        this.name=name;
        this.roll=roll;
    }
    public boolean has_course_name1(String s){
       if( course.course_name==null || s==null){
        return false;
       }
       return course.course_name.equals(s);
    }
    public static void main(String[] args) {
        Course c1=new Course("Internet of things", 1, 1000);
        Student s1= new Student("Ankit", 01, 100,c1);
        s1.displayInfo();
        boolean check=s1.has_course_name1("Internet of things");
        System.out.println(check);
        Student s2=new Student("abhay", 02);
        s2.displayInfo();
        Student s3= new Student("JAy", 103);
        s3.displayInfo();
        Student[] students = new Student[3];
        students[0]=s1;
        students[1]=s2;
        students[2]=s3;
        for (Student s : students) {
            s.displayInfo();
            System.out.println("-----------------");
        } 
    }
    }